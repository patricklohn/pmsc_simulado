# Supabase → Connect → Transaction pooler (porta 6543). Usuário no formato postgres.<project-ref>.
DB_HOST=aws-1-<regiao>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<project-ref>
# Coloque entre aspas se tiver # (ex.: DB_PASSWORD="abc#123")
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
MAX_DB_CONNECTIONS=3

# Access token (JWT HS256). Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_DAYS=30
