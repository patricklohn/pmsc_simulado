{
  "name": "pmsc_simulado",
  "private": true,
  "version": "1.0.0",
  "description": "Estudo para o concurso Soldado PMSC 2026: calendário do edital, grade de estudos e simulados (Next.js + Supabase)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "migrate:latest": "tsx --env-file-if-exists=.env.local src/database/db/migrate.ts",
    "migrate:down": "tsx --env-file-if-exists=.env.local src/database/db/migrate-down.ts",
    "migrate:types": "tsx --env-file-if-exists=.env.local src/database/db/codegen.ts",
    "migrate:seed": "tsx --env-file-if-exists=.env.local src/database/db/seeds.ts"
  },
  "author": "Patrick Lohn",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.105.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "kysely": "^0.28.18",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
